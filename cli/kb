#!/usr/bin/env python3
"""Entry point: system/tools/kb/kb <command>. Run with --help for the commands."""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.dont_write_bytecode = True

try:
    from kblib.cli import main
except ModuleNotFoundError as e:
    if e.name == "yaml":
        sys.exit("kb: PyYAML is missing; install it with: python3 -m pip install --user pyyaml")
    raise

sys.exit(main())
